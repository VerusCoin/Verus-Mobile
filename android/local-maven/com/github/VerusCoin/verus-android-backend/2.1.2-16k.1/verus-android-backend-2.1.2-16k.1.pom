<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  
  
  
  
  
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.github.VerusCoin</groupId>
  <artifactId>verus-android-backend</artifactId>
  <version>2.1.2-16k.1</version>
  <packaging>aar</packaging>
  <name>Zcash Android Wallet SDK</name>
  <description>This lightweight SDK connects Android to Zcash, allowing third-party Android apps to send and receive shielded transactions easily, securely and privately.</description>
  <url>https://github.com/zcash/zcash-android-wallet-sdk/</url>
  <inceptionYear>2018</inceptionYear>
  <licenses>
    <license>
      <name>The MIT License</name>
      <url>http://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>zcash</id>
      <name>Zcash</name>
      <url>https://github.com/zcash/</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/zcash/zcash-android-wallet-sdk.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/zcash/zcash-android-wallet-sdk.git</developerConnection>
    <url>https://github.com/zcash/zcash-android-wallet-sdk/</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>com.github.VerusCoin</groupId>
      <artifactId>lightwallet-client</artifactId>
      <version>2.1.2</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>androidx.annotation</groupId>
      <artifactId>annotation</artifactId>
      <version>1.7.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-kotlin-lite</artifactId>
      <version>4.26.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf-lite</artifactId>
      <version>1.63.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>1.9.23</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-core</artifactId>
      <version>1.8.0</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlinx</groupId>
      <artifactId>kotlinx-coroutines-android</artifactId>
      <version>1.8.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>